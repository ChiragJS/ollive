POSTGRES_USER=ollive
POSTGRES_PASSWORD=ollive
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

CHAT_DATABASE_URL=postgresql://ollive:ollive@postgres:5432/chat_app_db
OBSERVABILITY_DATABASE_URL=postgresql://ollive:ollive@postgres:5432/observability_db

NATS_URL=nats://nats:4222
INFERENCE_EVENTS_STREAM=INFERENCE_EVENTS
INFERENCE_EVENTS_SUBJECT=inference.events

APPLICATION_NAME=ollive-demo-chat
ENVIRONMENT=local
CHAT_SERVICE_NAME=chat-service
OBSERVABILITY_SERVICE_NAME=observability-service

# Use mock for local demo without paid API keys. Set openai/deepseek/groq/openrouter for real providers.
DEFAULT_PROVIDER=mock
DEFAULT_MODEL=mock-chat

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=Ollive Assignment

# Optional fallback transport for SDKs that cannot access NATS directly.
OBSERVABILITY_HTTP_URL=http://observability-service:8001/v1/ingest/events

# PII redaction policy for telemetry previews: standard, strict, or off.
PII_REDACTION_MODE=standard
PII_PREVIEW_MAX_CHARS=500
